# Copy to .env and edit. Never commit .env.
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# Shared secret: must equal contextlayer.agent.secret in the Spring Boot backend
AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# Where the Spring Boot backend runs (Spring is run from IntelliJ/mvn on your PC)
BACKEND_URL=http://localhost:8080
# Only needed if the backend runs in Docker and project paths look like /workspace/my-repo.
# Format: container_prefix=host_prefix   e.g.  /workspace=C:/Users/Asus/Desktop
AGENT_PATH_MAP=

# LLM: ollama (local, free) | openai_compat (any hosted OpenAI-style API) | mock (tests)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
LLM_NUM_CTX=4096
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=300
LLM_KEEP_ALIVE=30s
# Only for openai_compat
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Where run records are saved (JSON files). Relative to the agent folder.
AGENT_DATA_DIR=.agent_data
# true = ask the LLM to analyse tasks and write plans; false = fast heuristics and templates only
AGENT_USE_LLM=true
# The agent asks at most this many clarifying questions per task
AGENT_MAX_QUESTIONS=3
# Build and test commands run in a private copy of your project (Days 11 to 15)
AGENT_COMMAND_TIMEOUT=900
AGENT_MAX_OUTPUT=60000
AGENT_IMPLEMENT_ATTEMPTS=2
AGENT_MAX_REPAIRS=3
AGENT_REPAIR_SECONDS=1800
AGENT_MAVEN_OPTS=-Xmx768m
AGENT_NODE_OPTS=--max-old-space-size=1024
# Context pack limits (tokens are estimated as characters / 4)
PACK_DEFAULT_TOKENS=6000
MAX_FILE_BYTES=300000